root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 240

[Makefile]
indent_style = tab

# Documentation files configuration
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = unset