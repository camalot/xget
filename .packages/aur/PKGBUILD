# Maintainer: Ryan Conrad <camalot@gmail.com>
# This file is a template: __VERSION__, __ARCHITECTURES__, and __SOURCES__
# are substituted (e.g. via sed, gotemplate, or jinja2) by .github/actions/aur
# before it is committed to the AUR git repository.
pkgname=xget-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc="Easily get pre-built binaries for your favorite tools. It downloads and extracts pre-built binaries from releases on GitHub or GitLab."
arch=(__ARCHITECTURES__)
url="https://github.com/camalot/xget"
license=('MIT')
provides=('xget')
conflicts=('xget')
depends=()
options=('!strip' '!emptydirs')

__SOURCES__

package() {
	install -Dm755 "$srcdir/xget" "$pkgdir/usr/bin/xget"
	install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$srcdir/xget.1" "$pkgdir/usr/share/man/man1/xget.1"
}
