# Maintainer: Ryan Conrad <camalot@gmail.com>
# This file is a template: __VERSION__, __SHA256_X86_64__, and __SHA256_AARCH64__
# are substituted (e.g. via sed, gotemplate, or jinja2) by .github/actions/aur
# before it is committed to the AUR git repository.
pkgname=xget-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc="Easily get pre-built binaries for your favorite tools. It downloads and extracts pre-built binaries from releases on GitHub or GitLab."
arch=('x86_64' 'aarch64')
url="https://github.com/camalot/xget"
license=('MIT')
provides=('xget')
conflicts=('xget')
depends=('glibc')
options=('!strip' '!emptydirs')

source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::https://github.com/camalot/xget/releases/download/v$pkgver/xget_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::https://github.com/camalot/xget/releases/download/v$pkgver/xget_${pkgver}_linux_arm64.tar.gz")

sha256sums_x86_64=('__SHA256_X86_64__')
sha256sums_aarch64=('__SHA256_AARCH64__')

package() {
	install -Dm755 "$srcdir/xget" "$pkgdir/usr/bin/xget"
	install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 "$srcdir/xget.1" "$pkgdir/usr/share/man/man1/xget.1"
}
